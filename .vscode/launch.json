{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug G474 (ST-Link)",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/Debug/G474.elf",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/G474.elf"
                }
            ],
            "runEntry": "main",
            "preBuild": ""
        },
        {
            "name": "Debug G474 (Wireless CMSIS-DAP)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/G474.elf",
            "servertype": "openocd",
            "serverpath": "D:/03_Tools/msys64/mingw64/bin/openocd.exe",
            "gdbPath": "D:/03_Tools/msys64/mingw64/bin/gdb-multiarch.exe",
            "interface": "swd",
            "device": "STM32G474VET6",
            "connectUnderReset": true,
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32g4x.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 400",
                "reset_config srst_only srst_nogate connect_assert_srst"
            ],
            "preLaunchCommands": [
                "set remotetimeout 10"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        },
        {
            "name": "Release G474 (Wireless CMSIS-DAP)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Release/G474.elf",
            "servertype": "openocd",
            "serverpath": "D:/03_Tools/msys64/mingw64/bin/openocd.exe",
            "gdbPath": "D:/03_Tools/msys64/mingw64/bin/gdb-multiarch.exe",
            "interface": "swd",
            "device": "STM32G474VET6",
            "connectUnderReset": true,
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32g4x.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 400",
                "reset_config srst_only srst_nogate connect_assert_srst"
            ],
            "preLaunchCommands": [
                "set remotetimeout 10"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        },
        {
            "name": "Attach G474 (Wireless CMSIS-DAP, No Download)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/G474.elf",
            "servertype": "openocd",
            "serverpath": "D:/03_Tools/msys64/mingw64/bin/openocd.exe",
            "gdbPath": "D:/03_Tools/msys64/mingw64/bin/gdb-multiarch.exe",
            "interface": "swd",
            "device": "STM32G474VET6",
            "connectUnderReset": true,
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32g4x.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 400",
                "reset_config srst_only srst_nogate connect_assert_srst"
            ],
            "preAttachCommands": [
                "set remotetimeout 10"
            ],
            "showDevDebugOutput": "raw"
        }
    ]
}
